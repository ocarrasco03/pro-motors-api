<?php

namespace {{ namespace }};

final readonly class {{ class }}
{
    public function __construct(
        public int $example
    ) {}

    public static function fromArray(array $data): self
    {
        return new self(
            example: $data['example']
        );
    }

    public function toArray(): array
    {
        return [
            'example' => $this->example
        ];
    }
}
